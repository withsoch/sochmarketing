# Cal.com (or other scheduler) link used by every "Get a quote" CTA.
# Falls back to a placeholder Cal.com slug when unset — replace with the real one.
NEXT_PUBLIC_BOOKING_URL=https://cal.com/soch/30min

# Optional: a live scheduler embed URL (e.g. Cal.com/Calendly). When unset, a
# styled fallback card is shown instead of an iframe embed.
NEXT_PUBLIC_SCHEDULER_URL=

# Webhook the "Free Venue Audit" form POSTs to (e.g. an n8n webhook). When
# unset, the form falls back to opening a prefilled mailto: instead of
# failing silently against a URL that doesn't exist yet.
NEXT_PUBLIC_AUDIT_WEBHOOK_URL=
